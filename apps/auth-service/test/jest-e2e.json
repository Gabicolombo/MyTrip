{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "roots": ["<rootDir>/apps/auth-service/test"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^apps/(.*)$": "<rootDir>/apps/$1",
    "^y/database(|/.*)$": "<rootDir>/libs/database/src/$1",
    "^y/crypto(|/.*)$": "<rootDir>/libs/crypto/src/$1"
  }
}
